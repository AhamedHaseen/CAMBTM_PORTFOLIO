# Cambridge Marketing (CAMBM) - Environment Variables
PORT=5000
NODE_ENV=development

# JWT Secret for admin session tokens (Change to a long random secret in production)
JWT_SECRET=cambm_super_secure_jwt_secret_key_2026_@cambridge_marketing!

# Supabase PostgreSQL Connection String
# Find this in: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase API Settings (Optional if using direct DATABASE_URL)
# Find these in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hostinger SMTP & Email Settings (Used for 2FA verification & contact forms)
# Configurable via Admin Dashboard -> Settings -> SMTP Settings, or directly here:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Cambridge Marketing Security <noreply@cambridgemarketing.com>"
ADMIN_NOTIFY_EMAIL=
